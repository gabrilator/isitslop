GOOGLE_GENAI_API_KEY=

# Optional analytics (umami.is): no cookies, no consent banner.
# Set the website id to enable; leave empty to ship zero analytics.
PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# MCP endpoint at /mcp (Claude Code: claude mcp add --transport http isitslop https://<your-domain>/mcp).
# Off until all four are set. MCP_SECRET: 32+ random characters (openssl rand -base64 32).
# The Google client is a Web application with <origin>/oauth/google/callback as its redirect URI.
MCP_ALLOWED_EMAILS=
MCP_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
